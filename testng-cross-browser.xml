<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross-browser" parallel="tests" thread-count="3" data-provider-thread-count="2" verbose="3">

    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="io.github.alwih.selenium.runner.CucumberRunner"/>
        </classes>
    </test>

    <test name="Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="io.github.alwih.selenium.runner.CucumberRunner"/>
        </classes>
    </test>

    <test name="Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="io.github.alwih.selenium.runner.CucumberRunner"/>
        </classes>
    </test>

</suite>